# Secret NextAuth (générer une chaîne aléatoire longue, ex: openssl rand -base64 32)
NEXTAUTH_SECRET=

# URL canonique du site (ex: https://votre-site.netlify.app) — requis en production
NEXTAUTH_URL=

# Turso (libSQL) — laisser vide en dev local pour utiliser le fichier SQLite local (data/agency.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Origines autorisées pour CORS (par défaut: *)
CORS_ORIGINS=

# Resend (resend.com) — envoi des emails de confirmation de rendez-vous. Sans clé, l'email est juste loggé côté serveur.
RESEND_API_KEY=

# Secret partagé entre la Netlify Scheduled Function (netlify/functions/relances-cron.mjs)
# et l'endpoint protégé /api/cron/relances — générer une chaîne aléatoire longue.
CRON_SECRET=
